# Copy to .env.local (git-ignored). Nothing here is needed to compute a score —
# scoring is fully client-side against public endpoints. These only affect
# GitHub sign-in, which proves handle ownership and lifts the GitHub API limit
# from 60 to 5,000 req/hr.

# Required for sign-in. Server-only: read by src/lib/github-oauth.ts, never
# bundled for the browser. GitHub has no PKCE, so the callback code cannot be
# exchanged for a token without it. Generate one in the GitHub app's settings,
# and register a Callback URL there for every origin you run on:
#   http://localhost:3000/api/github/callback
#   https://<your-deployment>/api/github/callback
GITHUB_CLIENT_SECRET=

# Optional. The committed default is a public identifier, like the
# WalletConnect projectId; set this only to point at a different GitHub app.
# Must be the client ID that matches GITHUB_CLIENT_SECRET above.
# NEXT_PUBLIC_GITHUB_CLIENT_ID=

# Required for the data-transfer opt-out flow (temporary, Talent Protocol
# shutdown). Server-only: read by src/lib/talent-api.ts, never bundled for
# the browser. Every talent-api request needs this key, which is why the
# opt-out routes (src/app/api/opt-out/*) proxy to talent-api instead of the
# browser calling it directly.
TALENT_API_KEY=

# Optional override of the talent-api base URL; defaults to
# https://api.talentprotocol.com.
# TALENT_API_URL=
